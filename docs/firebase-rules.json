{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'online'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
        "messages": {
          ".indexOn": ["createdAt"],
          "$messageId": {
            ".write": "auth != null && !data.exists() && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
            ".validate": "newData.hasChildren(['senderId', 'type', 'createdAt']) && ((newData.child('type').val() === 'text' && newData.child('text').isString() && !newData.child('lat').exists() && !newData.child('lng').exists()) || (newData.child('type').val() === 'location' && newData.child('lat').isNumber() && newData.child('lng').isNumber() && !newData.child('text').exists()))",
            "senderId": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "type": {
              ".validate": "newData.isString() && (newData.val() === 'text' || newData.val() === 'location')"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
            },
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === $peer)",
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $peer)",
          ".validate": "newData.hasChildren(['peerName', 'lastMessage', 'lastType', 'lastAt'])",
          "peerName": {
            ".validate": "newData.isString() && newData.val() === root.child('users').child($peer).child('name').val()"
          },
          "lastMessage": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "lastType": {
            ".validate": "newData.isString() && (newData.val() === 'text' || newData.val() === 'location')"
          },
          "lastAt": {
            ".validate": "newData.isNumber()"
          },
          "unread": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && newData.val() % 1 === 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
